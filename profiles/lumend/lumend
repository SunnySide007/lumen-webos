#!/bin/sh
# lumend's door (decision 14), a Homebrew Channel boot hook:
# /var/lib/webosbrew/init.d/lumend. It checks the kill switch and lumend's
# files, then starts the daemon with its start time-boxed, in the
# background. Everything else is lumend's own (shell/crates/lumend), each
# part behind its switch in /var/lib/lumen/lumend/lumend.conf.
#
# docs/safety.md: nothing while the kill switch exists; returns at once.
# Without a working timeout command it starts nothing. Install, check or
# remove it with tools/lumend.sh; tools/uninstall-all.sh removes it too.

KILL=/var/luna/preferences/lumen_disable
DIR=/var/lib/lumen/lumend
BIN=$DIR/lumend
ROOT_UID=0

[ -e "$KILL" ] && exit 0

# Root's own: the folder and the binary, not links, writable by no one else.
for f in /var/lib/lumen "$DIR" "$BIN"; do
    if [ ! -e "$f" ] || [ -L "$f" ]; then exit 0; fi
    # shellcheck disable=SC2046,SC2012 # ls -ldn's mode and owner, as words
    set -- $(ls -ldn "$f")
    case $1 in ?????[!w]??[!w]*) ;; *) exit 0 ;; esac
    [ "$3" = "$ROOT_UID" ] || exit 0
done

# busybox before 1.30 takes `timeout -t SECONDS`; later ones `timeout SECONDS`.
if timeout -t 1 true 2>/dev/null; then
    set -- timeout -t 15
elif timeout 1 true 2>/dev/null; then
    set -- timeout 15
else
    exit 0
fi
"$@" "$BIN" start </dev/null >/dev/null 2>&1 &
exit 0
