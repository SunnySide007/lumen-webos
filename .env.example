# Copy to .env (git ignores it) and fill in your TV's details.
# tools/tv.sh reads these. SSH uses key authentication only.

# The TV's IP address. A DHCP reservation on your router keeps it stable.
TV_HOST=192.168.1.50

# Root over SSH, as Homebrew Channel provides it.
TV_USER=root
TV_PORT=22

# Private key whose public half you added to the TV's authorized_keys.
TV_KEY=~/.ssh/lumen_tv
