{
  "name": "lumen-remote-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Lumen Remote: the web front-end shared by the PC app and the phone",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/size.ts",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --project=smoke",
    "capture": "playwright test --project=capture"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
