#!/bin/sh
# Route D's boot hook (takeover/README.md), for Homebrew Channel:
# /var/lib/webosbrew/init.d/lumen-home (run-parts allows no dot in the name).
# With Lumen as the TV's Home, LG's Home still starts at boot (preloaded on
# snapshot boots, and on SAM's keep-alive list) and runs unseen, as root,
# calling LG's servers. This hook closes it the way LG's home_launcher.sh
# closes the home it doesn't use: applicationManager/closeByAppId with
# forceMode. It never chooses the home: when settingsservice's
# defaultApps.home is not Lumen's id, it says so and does nothing.
# Only tools/takeover.sh apply, by hand, sets that.
#
# In the background: it waits for SAM to answer (at most a minute), then
# once a minute for about four minutes reads the default home and, while it
# is Lumen, closes LG's Home if it runs and isn't in front, and logs SAM's
# running list 10 s later: LG's Home gone, still exiting (the pid it had),
# or brought back by keep-alive (another pid).
#
# docs/safety.md: it does nothing while the kill switch exists, returns at
# once, and its background work ends by itself within five minutes; without
# a working timeout command for its luna calls it does nothing at all. It
# writes only its log. Nothing it does outlasts the next boot: LG's Home
# starts again then. Not persistent until installed: tools/takeover.sh hook
# push leaves an inert copy that takeover/home-apply.sh runs by hand, and
# tools/takeover.sh hook install, after that run and the owner's yes,
# installs it. Log: /var/lib/lumen/log/lumen-home.log, and the run before in
# lumen-home.log.1 (log_to, below). With no safe log folder it does its work
# unlogged, and tools/takeover.sh hook status says "no log".
# tools/uninstall-all.sh removes the log with /var/lib/lumen.

KILL=/var/luna/preferences/lumen_disable
LOGDIR=/var/lib/lumen/log
LOG=$LOGDIR/lumen-home.log
ROOT_UID=0
ID=io.github.sunnyside007.lumen.shell
LG=com.webos.app.home
AM=com.webos.applicationManager
# Seconds after the start by which the last round begins. A round is at most
# five luna calls of 5 s and a 10 s wait, so all is over by 295 s.
DEADLINE=260

[ -e "$KILL" ] && exit 0

# folder_ok FOLDER...: each is a real folder, not a link, owned by root and
# writable by no one else.
folder_ok() {
    for d in "$@"; do
        if [ -L "$d" ] || [ ! -d "$d" ]; then
            echo "$d is not a real folder"
            return 1
        fi
        # ls -ln is POSIX, and stat is not: its mode and owner, split into words.
        # shellcheck disable=SC2046,SC2012
        set -- $(ls -ldn "$d")
        case $1 in
            d????[!w]??[!w]*) ;;
            *)
                echo "$d is writable by others ($1)"
                return 1
                ;;
        esac
        if [ "$3" != "$ROOT_UID" ]; then
            echo "$d is owned by uid $3, not root"
            return 1
        fi
    done
}

# log_to: starts this run's log and prints where its output goes. Root writes
# nothing into /tmp, which every app's jail shares: a link put there before a
# boot hook runs would send root's writes wherever it points. So the log is
# $LOG, in a folder made with umask 077 and used only once it and
# /var/lib/lumen pass folder_ok. The last run's log moves to $LOG.1 first,
# which keeps one earlier boot, and the new one is made before the hook goes
# into the background. A folder that fails gets no log: the hook does its
# work all the same, with its output to /dev/null, and says why on stderr.
log_to() {
    mkdir -p "${LOGDIR%/*}"
    if folder_ok "${LOGDIR%/*}" >&2 && (umask 077 && mkdir -p "$LOGDIR") &&
        folder_ok "$LOGDIR" >&2 && { [ ! -e "$LOG" ] || mv -f "$LOG" "$LOG.1"; } &&
        : >"$LOG"; then
        echo "$LOG"
    else
        echo "no log: this run's output goes to /dev/null" >&2
        echo /dev/null
    fi
}

OUT=$(log_to)
(
    say() {
        echo "$(date -u) $*"
    }

    # Seconds since boot: the wall clock jumps when the TV sets it.
    uptime_s() {
        read -r up _ </proc/uptime
        echo "${up%%.*}"
    }

    # ask METHOD PAYLOAD: luna's answer on one line, empty when none.
    ask() {
        # shellcheck disable=SC2086 # $TIMEOUT is a command and its argument
        $TIMEOUT luna-send -n 1 "luna://$1" "$2" </dev/null 2>/dev/null
    }

    default_home() {
        ask com.webos.settingsservice/getSystemSettings '{"category":"general","key":"defaultApps"}' |
            sed -n 's/.*"defaultApps"[[:space:]]*:[[:space:]]*{[^{}]*"home"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
    }

    # ids_in LIST: the ids in SAM's running list (its answer), on one line.
    ids_in() {
        printf '%s\n' "$1" | grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' |
            sed 's/.*"\([^"]*\)"$/\1/' | tr '\n' ' '
    }

    # lg_pid_in LIST: LG's Home's processid in SAM's running list, or nothing.
    # Each app is one flat object there.
    lg_pid_in() {
        printf '%s\n' "$1" | grep -o "{[^{}]*\"id\"[[:space:]]*:[[:space:]]*\"$LG\"[^{}]*}" |
            sed -n 's/.*"processid"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1
    }

    lg_in() {
        case " $(ids_in "$1") " in
            *" $LG "*) return 0 ;;
        esac
        return 1
    }

    lg_in_front() {
        ask "$AM/getForegroundAppInfo" '{}' | grep -q "\"appId\"[[:space:]]*:[[:space:]]*\"$LG\""
    }

    ok() {
        printf '%s\n' "$1" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*true'
    }

    start=$(uptime_s)
    say "lumen-home: start"

    # Every luna call is time-boxed, or the hook could hang (safety rule 4).
    # busybox before 1.30 wants `timeout -t SECS`; coreutils wants
    # `timeout SECS`.
    if timeout -t 1 true >/dev/null 2>&1; then
        TIMEOUT="timeout -t 5"
    elif timeout 1 true >/dev/null 2>&1; then
        TIMEOUT="timeout 5"
    else
        say "no timeout command; nothing done"
        say "lumen-home: done"
        exit 0
    fi

    tries=0
    until ok "$(ask "$AM/running" '{}')"; do
        tries=$((tries + 1))
        if [ "$tries" -ge 6 ] || [ -e "$KILL" ]; then
            say "SAM never answered; nothing done"
            say "lumen-home: done"
            exit 0
        fi
        sleep 5
    done
    say "SAM answers"

    round=0
    while [ ! -e "$KILL" ]; do
        round=$((round + 1))
        home=$(default_home)
        if [ "$home" != "$ID" ]; then
            say "the default home is ${home:-unreadable}, not Lumen; nothing done"
            break
        fi
        list=$(ask "$AM/running" '{}')
        if ! ok "$list"; then
            say "round $round: SAM didn't answer"
        elif ! lg_in "$list"; then
            say "round $round: LG Home is not running"
        elif lg_in_front; then
            say "round $round: LG Home is in front; left alone"
        else
            pid=$(lg_pid_in "$list")
            answer=$(ask "$AM/closeByAppId" "{\"id\":\"$LG\",\"forceMode\":true}")
            if ok "$answer"; then
                say "round $round: closed LG Home (pid ${pid:-unknown})"
            else
                say "round $round: FAILED to close LG Home: ${answer:-no answer}"
            fi
            sleep 10
            # The same pid is LG's Home still on its way out (the B9 took
            # more than 10 s on 2026-10-31); another is keep-alive's restart.
            list=$(ask "$AM/running" '{}')
            ids=$(ids_in "$list")
            now=$(lg_pid_in "$list")
            if ! ok "$list"; then
                say "round $round: SAM didn't answer 10 s later"
            elif ! lg_in "$list"; then
                say "round $round: LG Home stayed closed 10 s later; running: $ids"
            elif [ -z "$pid" ] || [ -z "$now" ]; then
                say "round $round: LG Home still listed 10 s later, pid unknown; running: $ids"
            elif [ "$now" = "$pid" ]; then
                say "round $round: LG Home still exiting 10 s later (pid $pid); running: $ids"
            else
                say "round $round: LG Home is back 10 s later as pid $now (was $pid); running: $ids"
            fi
        fi
        # The next round only if it can start by the deadline.
        [ "$round" -lt 5 ] || break
        [ $(($(uptime_s) - start + 60)) -le "$DEADLINE" ] || break
        sleep 60
    done
    say "lumen-home: done"
) </dev/null >>"$OUT" 2>&1 &
